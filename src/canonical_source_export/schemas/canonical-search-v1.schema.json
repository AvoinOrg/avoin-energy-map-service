{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.avoin.example/canonical-search-v1.schema.json",
  "$comment": "Specification only. x-text is mandatory; see contract. Validate named $defs independently.",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Page"
    },
    {
      "$ref": "#/$defs/Error"
    }
  ],
  "$defs": {
    "Key": {
      "type": "string",
      "x-text": {
        "minBytes": 1,
        "maxBytes": 256,
        "nonblank": false
      }
    },
    "PermanentId": {
      "type": "string",
      "x-text": {
        "minBytes": 1,
        "maxBytes": 256,
        "nonblank": true
      }
    },
    "PropertyId": {
      "type": "string",
      "pattern": "^[0-9]{14}$",
      "not": {
        "const": "00000000000000"
      }
    },
    "LabelField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "x-text": {
                "minBytes": 1,
                "maxBytes": 512,
                "nonblank": true
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "missing",
            "invalid",
            "not_projected",
            "unavailable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "x-text": {
                "minBytes": 1,
                "maxBytes": 128,
                "nonblank": true
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "status",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "x-text": {
                  "minBytes": 1,
                  "maxBytes": 512,
                  "nonblank": true
                }
              },
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "string",
                "x-text": {
                  "minBytes": 1,
                  "maxBytes": 128,
                  "nonblank": true
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "missing",
                  "not_projected",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string",
              "x-text": {
                "minBytes": 1,
                "maxBytes": 256,
                "nonblank": true
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "missing",
            "invalid",
            "not_projected",
            "unavailable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "x-text": {
                "minBytes": 1,
                "maxBytes": 128,
                "nonblank": true
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "status",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "x-text": {
                  "minBytes": 1,
                  "maxBytes": 256,
                  "nonblank": true
                }
              },
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "string",
                "x-text": {
                  "minBytes": 1,
                  "maxBytes": 128,
                  "nonblank": true
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "missing",
                  "not_projected",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Address": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "x-text": {
            "minBytes": 1,
            "maxBytes": 128,
            "nonblank": true
          }
        },
        "address_key": {
          "anyOf": [
            {
              "type": "string",
              "x-text": {
                "minBytes": 1,
                "maxBytes": 256,
                "nonblank": false
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "address_edge",
            "main_display"
          ]
        },
        "fi": {
          "$ref": "#/$defs/LabelField"
        },
        "sv": {
          "$ref": "#/$defs/LabelField"
        },
        "postal_office_fi": {
          "$ref": "#/$defs/LabelField"
        },
        "postal_office_sv": {
          "$ref": "#/$defs/LabelField"
        },
        "postal_code": {
          "allOf": [
            {
              "$ref": "#/$defs/Fact"
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "available"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "string",
                    "pattern": "^[0-9]{5}$"
                  }
                }
              }
            }
          ]
        },
        "municipality_number": {
          "allOf": [
            {
              "$ref": "#/$defs/Fact"
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "available"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "string",
                    "pattern": "^[0-9]{3}$"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "namespace",
        "address_key",
        "kind",
        "fi",
        "sv",
        "postal_office_fi",
        "postal_office_sv",
        "postal_code",
        "municipality_number"
      ]
    },
    "SourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "main",
            "building",
            "address",
            "pelias",
            "nls"
          ]
        },
        "projection_version": {
          "type": "string",
          "x-text": {
            "minBytes": 1,
            "maxBytes": 128,
            "nonblank": true
          }
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string",
              "x-text": {
                "minBytes": 1,
                "maxBytes": 256,
                "nonblank": true
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "source_version_status": {
          "type": "string",
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "address": {
              "type": "string",
              "enum": [
                "included",
                "partial",
                "unsupported",
                "unavailable"
              ]
            },
            "property_identifier": {
              "type": "string",
              "enum": [
                "included",
                "partial",
                "unsupported",
                "unavailable"
              ]
            },
            "permanent_building_identifier": {
              "type": "string",
              "enum": [
                "included",
                "partial",
                "unsupported",
                "unavailable"
              ]
            }
          },
          "required": [
            "address",
            "property_identifier",
            "permanent_building_identifier"
          ]
        },
        "membership": {
          "type": "string",
          "enum": [
            "complete_export",
            "partial",
            "not_applicable"
          ]
        },
        "address_edges": {
          "type": "string",
          "enum": [
            "complete_export",
            "partial",
            "not_projected",
            "not_applicable"
          ]
        },
        "fi": {
          "type": "string",
          "enum": [
            "available",
            "partial",
            "not_projected",
            "unknown",
            "not_applicable"
          ]
        },
        "sv": {
          "type": "string",
          "enum": [
            "available",
            "partial",
            "not_projected",
            "unknown",
            "not_applicable"
          ]
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "string",
            "x-text": {
              "minBytes": 1,
              "maxBytes": 256,
              "nonblank": true
            }
          },
          "maxItems": 16
        }
      },
      "required": [
        "source",
        "projection_version",
        "source_version",
        "source_version_status",
        "modes",
        "membership",
        "address_edges",
        "fi",
        "sv",
        "omissions"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source_version_status": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "source_version": {
                "type": "string",
                "x-text": {
                  "minBytes": 1,
                  "maxBytes": 256,
                  "nonblank": true
                }
              }
            }
          },
          "else": {
            "properties": {
              "source_version": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage_version": {
          "const": "canonical-coverage-v1",
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "synthetic_fixture",
            "coherent_export",
            "partial_export"
          ]
        },
        "national_completeness": {
          "type": "string",
          "enum": [
            "unknown",
            "incomplete",
            "proven_complete"
          ]
        },
        "national_evidence": {
          "anyOf": [
            {
              "type": "string",
              "x-text": {
                "minBytes": 1,
                "maxBytes": 256,
                "nonblank": true
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceCoverage"
          },
          "maxItems": 8,
          "minItems": 3
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "string",
            "x-text": {
              "minBytes": 1,
              "maxBytes": 256,
              "nonblank": true
            }
          },
          "maxItems": 16
        }
      },
      "required": [
        "coverage_version",
        "scope",
        "national_completeness",
        "national_evidence",
        "sources",
        "omissions"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "synthetic_fixture"
              }
            }
          },
          "then": {
            "properties": {
              "national_completeness": {
                "const": "unknown"
              },
              "national_evidence": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "national_completeness": {
                "const": "proven_complete"
              }
            }
          },
          "then": {
            "properties": {
              "national_evidence": {
                "type": "string",
                "x-text": {
                  "minBytes": 1,
                  "maxBytes": 256,
                  "nonblank": true
                }
              }
            }
          }
        }
      ]
    },
    "Generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "x-text": {
            "minBytes": 1,
            "maxBytes": 128,
            "nonblank": true
          }
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "export_id": {
          "type": "string",
          "x-text": {
            "minBytes": 1,
            "maxBytes": 128,
            "nonblank": true
          }
        },
        "provider_generation": {
          "anyOf": [
            {
              "type": "string",
              "x-text": {
                "minBytes": 1,
                "maxBytes": 256,
                "nonblank": true
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_generation_status": {
          "type": "string",
          "enum": [
            "known",
            "unknown"
          ]
        },
        "exported_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
        }
      },
      "required": [
        "id",
        "bundle_sha256",
        "export_id",
        "provider_generation",
        "provider_generation_status",
        "exported_at"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "provider_generation_status": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "provider_generation": {
                "type": "string",
                "x-text": {
                  "minBytes": 1,
                  "maxBytes": 256,
                  "nonblank": true
                }
              }
            }
          },
          "else": {
            "properties": {
              "provider_generation": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "PeliasFilters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "countrycodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "bbox": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "lat",
            "lon"
          ]
        }
      },
      "required": []
    },
    "Query": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "address",
              "type": "string"
            },
            "text": {
              "type": "string",
              "x-text": {
                "minBytes": 1,
                "maxBytes": 512,
                "nonblank": true
              }
            },
            "strategy": {
              "type": "string",
              "enum": [
                "registry_exact",
                "pelias_link",
                "normalized_tuple"
              ]
            },
            "postal_code": {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            "municipality_number": {
              "type": "string",
              "pattern": "^[0-9]{3}$"
            },
            "pelias_filters": {
              "$ref": "#/$defs/PeliasFilters"
            }
          },
          "required": [
            "mode",
            "text",
            "strategy"
          ],
          "allOf": [
            {
              "if": {
                "required": [
                  "pelias_filters"
                ]
              },
              "then": {
                "properties": {
                  "strategy": {
                    "const": "pelias_link"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "property_identifier",
              "type": "string"
            },
            "property_identifier": {
              "type": "string",
              "pattern": "^[0-9]{14}$",
              "not": {
                "const": "00000000000000"
              }
            }
          },
          "required": [
            "mode",
            "property_identifier"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "permanent_building_identifier",
              "type": "string"
            },
            "permanent_building_identifier": {
              "$ref": "#/$defs/PermanentId"
            }
          },
          "required": [
            "mode",
            "permanent_building_identifier"
          ]
        }
      ]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "identifier_equality",
            "source_key",
            "exact_address_tuple"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "main",
            "building",
            "address"
          ]
        },
        "namespace": {
          "type": "string",
          "x-text": {
            "minBytes": 1,
            "maxBytes": 128,
            "nonblank": true
          }
        },
        "source_row_id": {
          "anyOf": [
            {
              "type": "string",
              "x-text": {
                "minBytes": 1,
                "maxBytes": 256,
                "nonblank": false
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "address_key": {
          "anyOf": [
            {
              "type": "string",
              "x-text": {
                "minBytes": 1,
                "maxBytes": 256,
                "nonblank": false
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "source_modified": {
          "$ref": "#/$defs/Fact"
        }
      },
      "required": [
        "kind",
        "source",
        "namespace",
        "source_row_id",
        "address_key",
        "source_modified"
      ]
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "building_key": {
          "$ref": "#/$defs/Key"
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "main",
              "building"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "permanent": {
          "$ref": "#/$defs/Fact"
        },
        "property": {
          "$ref": "#/$defs/PropertyFact"
        },
        "requires_explicit_choice": {
          "const": true,
          "type": "boolean"
        },
        "requires_canonical_confirmation": {
          "const": true,
          "type": "boolean"
        },
        "identity_conflict": {
          "const": false,
          "type": "boolean"
        },
        "display_address": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_language": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "fi",
                "sv"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "language_fallback": {
          "type": "boolean"
        },
        "matching_addresses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Address"
          },
          "maxItems": 4
        },
        "address_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "matching_address_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "addresses_omitted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "evidence_omitted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "geometry": {
          "type": "string",
          "enum": [
            "present_unvalidated",
            "missing_in_scope",
            "not_projected"
          ]
        },
        "location": {
          "type": "null"
        }
      },
      "required": [
        "building_key",
        "anchors",
        "permanent",
        "property",
        "requires_explicit_choice",
        "requires_canonical_confirmation",
        "identity_conflict",
        "display_address",
        "display_language",
        "language_fallback",
        "matching_addresses",
        "address_count",
        "matching_address_count",
        "addresses_omitted",
        "evidence",
        "evidence_count",
        "evidence_omitted",
        "geometry",
        "location"
      ]
    },
    "Context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "x-text": {
            "minBytes": 1,
            "maxBytes": 128,
            "nonblank": true
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "unmatched_place",
            "associated_address",
            "hypothesis"
          ]
        },
        "label": {
          "type": "string",
          "x-text": {
            "minBytes": 1,
            "maxBytes": 512,
            "nonblank": true
