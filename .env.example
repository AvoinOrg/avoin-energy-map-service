# DB
PGHOST=db
PGPORT=5432
PGDATABASE=avoin_energy_map_db
PGUSER=postgres
PGPASSWORD=postgres

SANDBOX_PGHOST=sandbox_db_host
SANDBOX_PGPORT=sandbox_db_port
SANDBOX_PGDATABASE=sandbox_db_name
SANDBOX_PGUSER=sandbox_db_user
SANDBOX_PGPASSWORD=sandbox_db_password

# Sandbox GeoServer admin. Keep real values in ignored local env files only.
GEOSERVER_BASE_URL=https://sandbox.gis.avoin.org/geoserver
GEOSERVER_USER=sandbox_geoserver_user
GEOSERVER_PASSWORD=sandbox_geoserver_password
GEOSERVER_WORKSPACE=sandbox_energiakartta
GEOSERVER_DATASTORE=avoin-postgres-energymap
GEOSERVER_TRUNCATE_GWC=true

# Upstream endpoints (fill with real URLs)
BUILDINGS_API_URL=https://paikkatiedot.ymparisto.fi/geoserver/ryhti_building/ogc/features/v1/collections/open_building/items?f=application%2Fjson
RYHTI_BUILDINGS_SNAPSHOT_URL=https://paikkatiedot.ymparisto.fi/geoserver/www/open_building.csv.gz
RYHTI_BUILDINGS_SNAPSHOT_PATH=data/ryhti-open-building.csv.gz
ADDRESSES_API_URL=https://paikkatiedot.ymparisto.fi/geoserver/ryhti_building/ogc/features/v1/collections/open_address/items?f=application%2Fjson
ENERGY_CERTIFICATES_CSV_URL=https://www.energiatodistusrekisteri.fi/api/public/energiatodistukset/csv/energiatodistukset.csv
ENERGY_CERTIFICATES_CSV_PATH=data/energiatodistukset.csv

# Stable public GeoServer area layers; release IDs remain an operator concern.
ENERGY_MAP_GEOSERVER_URL=https://sandbox.gis.avoin.org/geoserver
ENERGY_MAP_AREA_WORKSPACE=sandbox_energiakartta
# Run migrations separately from serving containers.
MIGRATE_ON_START=false
# Allowed frontend origins for the area-details API (comma-separated).
ENERGY_MAP_API_ORIGINS=http://127.0.0.1:8080,null

# Server-only Zitadel resource-server settings. Placeholders only; see
# src/api/authentication.md. Use dedicated Energy API credentials, not core's.
# Exact HTTPS issuer origin, WITHOUT a trailing slash.
ENERGY_MAP_ZITADEL_ISSUER=https://identity.example.invalid
ENERGY_MAP_ZITADEL_AUDIENCES='["<energy-api-audience>"]'
ENERGY_MAP_ZITADEL_CLIENT_ID=<dedicated-energy-api-introspection-client-id>
ENERGY_MAP_ZITADEL_CLIENT_SECRET=<dedicated-energy-api-introspection-client-secret>
# Optional all-of scopes; ordinary signed-in users need no extra permission.
ENERGY_MAP_ZITADEL_REQUIRED_SCOPES=

# Separate narrowly granted PostgreSQL writer. No analytical/sandbox fallback.
# Provision/migrate explicitly before enabling; see src/api/user-buildings.md.
ENERGY_MAP_STATE_ENABLED=false
ENERGY_MAP_STATE_DATABASE_URL=postgresql+psycopg2://<state-writer>:<url-encoded-password>@<state-host>:5432/<state-database>
